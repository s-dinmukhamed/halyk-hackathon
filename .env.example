# Primary provider: Gemini (text and vision)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Text fallback provider: Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# gemini | groq
LLM_PROVIDER=gemini

# Retrieval
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=6

# Retry and parallelism
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE=2.0
MAX_WORKERS=4

# Submission metadata
TEAM=id
CONTACT_EMAIL=you@example.com
MODEL_LABEL=gemini-2.0-flash

# FX conversion
EUR_USD_RATE=1.08
