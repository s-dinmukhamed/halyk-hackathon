# ------------------------------------------------------------------
# Halyk AI Challenge — agent config. Copy to `.env` and fill keys.
# Fully free stack: Gemini (primary) + Groq (fallback).
# ------------------------------------------------------------------

# Primary LLM: Google Gemini (free tier, vision, long context, RU/KZ).
# Get a free key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback LLM: Groq (free tier, fast, text-only, OpenAI-compatible).
# Get a free key (no card): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Which provider leads: gemini | groq
LLM_PROVIDER=gemini

# Embeddings for retrieval: local fastembed ONNX (free, ~700MB RAM).
EMBED_MODEL=BAAI/bge-small-en-v1.5

# How many retrieved chunks to feed the model per query.
TOP_K=6

# Retry/backoff for free-tier rate limits (RPM/RPD).
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE=2.0
